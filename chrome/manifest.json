{
  "name": "Blackbaud Next: Supercharge your education",
  "short_name": "Blackbaud Next",
  "description": "Enhance your Blackbaud experience with useful tools.",
  "version": "1.3.1",
  "manifest_version": 3,
  "minimum_chrome_version": "148",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/shared/namespace.js",
        "src/shared/settings.js",
        "src/shared/dom.js",
        "src/shared/routes.js",
        "src/shared/clipboard.js",
        "src/sources/network/performance.js",
        "src/sources/api/client.js",
        "src/sources/dom/native-shell.js",
        "src/data/normalize/roster.js",
        "src/data/normalize/avatar.js",
        "src/data/normalize/progress.js",
        "src/data/models/index.js",
        "src/auth/loading-overlay.js",
        "src/auth/login-flow.js",
        "src/auth/index.js",
        "src/native/controller.js",
        "src/native/index.js",
        "src/native-enhancements/favicon.js",
        "src/native-enhancements/assignment-center.js",
        "src/native-enhancements/roster-tools.js",
        "src/native-enhancements/avatar-download.js",
        "src/native-enhancements/index.js",
        "src/next/host.js",
        "src/boot/runtime.js",
        "src/boot/main.js"
      ],
      "matches": ["https://*.myschoolapp.com/*"]
    },
    {
      "js": [
        "src/shared/namespace.js",
        "src/shared/settings.js",
        "src/shared/dom.js",
        "src/shared/routes.js",
        "src/auth/loading-overlay.js",
        "src/auth/login-flow.js",
        "src/auth/index.js",
        "src/boot/auth-main.js"
      ],
      "matches": ["https://accounts.google.com/*", "https://*.blackbaud.com/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/blackbaud.png",
        "dist/next/inter-latin-wght-normal.woff2",
        "dist/next/next.css",
        "dist/next/next.js"
      ],
      "matches": ["https://*.myschoolapp.com/*"]
    }
  ],
  "icons": {
    "16": "assets/16x16.png",
    "32": "assets/32x32.png",
    "48": "assets/48x48.png",
    "128": "assets/128x128.png"
  }
}
