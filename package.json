{
  "name": "blackbaud-next",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm check && node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "dev:browser": "node scripts/dev-browser.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types --test tests/*.smoke.ts"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.19.2",
    "jsdom": "^30.1.3",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "lucide": "^1.66.0"
  }
}
